<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 컨디션 점수(기획서 13번)와 알림 신호(12번)에 쓰는 값만 읽습니다. 쓰기 권한은 없습니다. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <!-- 미션 자동 확인 (14번): 계단 오르기, 운동 기록 -->
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <!-- 아침 7:30에 앱을 열지 않아도 점수를 계산해 알림 -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 가족 서버 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <!-- Health Connect app on Android 13 and lower. -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".PulseApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 저녁 요약 알림의 "내일 다시" / "다른 미션으로" 버튼 -->
        <receiver
            android:name=".notify.EveningActionReceiver"
            android:exported="false" />

        <!-- 주의 알림의 "괜찮아요" / "잘못된 알림이에요" / "연락했어요" -->
        <receiver
            android:name=".notify.AlertFeedbackReceiver"
            android:exported="false" />

        <!-- 긴급 알림의 "확인했어요" / "취소하기" -->
        <receiver
            android:name=".family.EmergencyActionReceiver"
            android:exported="false" />

        <!-- 가족 서버 푸시 (FCM) -->
        <service
            android:name=".family.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 워치 앱에서 미션 완료, SOS -->
        <service
            android:name=".wear.PhoneListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/pulsecare"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Health Connect shows this when the user asks why the app needs access. -->
        <activity
            android:name=".ui.PermissionsRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+: same screen from the system's health permission settings. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".ui.PermissionsRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
