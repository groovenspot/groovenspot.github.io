generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 구매 경로. 기획안의 4개 경로와 1:1로 대응합니다.
enum Channel {
  WINERY_DIRECT // 와이너리 직배송
  EXPORT_RETAILER // 현지 수출 리테일러
  LOCAL_SHOP // 현지 내수 판매처 (배송대행지 경로의 물품 공급처)
  HK_RETAILER // 홍콩 경유 리테일러
}

enum PriceSource {
  MANUAL // 관리자 입력 또는 CSV
  JSONLD // 상품 페이지의 schema.org Product/Offer 크롤링
}

/// 판매처 결제 화면 여는 방식
enum CheckoutMode {
  PRODUCT_PAGE // 상품 페이지로 이동 (기본)
  SHOPIFY_CART // Shopify 장바구니 링크: 상품·수량 담고 이메일·배송지·메모 미리 채움
  CART_TEMPLATE // 판매처별 장바구니 URL 템플릿
}

enum OrderStatus {
  CLICKED // 판매처 결제 화면으로 이동
  CONFIRMED // 주문 확정
  SHIPPED // 발송
  CUSTOMS // 통관 중
  DELIVERED // 도착
  CANCELLED // 취소
}

enum ShipmentStage {
  INTERNATIONAL
  KOREA_ARRIVAL
  CUSTOMS
  TAX_NOTICE
  DOMESTIC
  DELIVERED
}

enum Plan {
  FREE
  PREMIUM
}

enum AlertChannel {
  KAKAO
  EMAIL
}

model Wine {
  id         String   @id @default(cuid())
  name       String // 원어 표기
  nameKo     String // 한글 표기
  producer   String
  country    String // 한글 국가명 (예: 프랑스)
  region     String
  type       String // 레드 / 화이트 / 스파클링 / 로제 / 주정강화 / 디저트
  grape      String   @default("")
  vintage    Int?
  aliases    String[] // 검색 보정용 추가 표기
  krPrice    Int? // 국내 판매가 (원, 750ml 기준). 미수입이면 null
  krPriceSrc String?
  rating     Float? // 외부 평점 요약 (100점 만점)
  ratingSrc  String?
  notesKo    String? // 한국어 테이스팅 노트
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  offers    Offer[]
  alerts    PriceAlert[]
  clicks    ClickLog[]
  purchases Purchase[]
  views     WineView[]
  orders    Order[]
  reviews   DirectReview[]

  @@index([country])
  @@index([type])
}

model Seller {
  id              String      @id @default(cuid())
  name            String
  country         String // 판매처 소재국 (홍콩 리테일러는 "홍콩")
  channel         Channel
  website         String
  shipsToKorea    Boolean     @default(true)
  currency        String // 판매 통화
  /// 한국까지 운임: 주문당 기본료 + 병당(750ml 환산) 요금. LOCAL_SHOP은 현지 배송대행지까지 운임.
  shipBase        Float       @default(0)
  shipPerBottle   Float       @default(0)
  daysMin         Int         @default(7)
  daysMax         Int         @default(14)
  insured         Boolean     @default(false)
  /// 제휴 링크 템플릿. {url} {clickId} 치환. 비우면 상품 URL 그대로 이동.
  affiliateTpl    String?
  commissionRate  Float       @default(0.07)
  priceSource     PriceSource @default(MANUAL)
  checkoutMode    CheckoutMode @default(PRODUCT_PAGE)
  /// CART_TEMPLATE용. {url} {ref} {qty} {clickId} {email} {note} 치환
  cartTpl         String?
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  offers    Offer[]
  crawlRuns CrawlRun[]
  reviews   DirectReview[]
  orders    Order[]
}

/// 배송대행지. 원산지 국가 내수 판매처 물품을 받아 한국으로 보냅니다.
model Forwarder {
  id             String  @id @default(cuid())
  name           String
  country        String
  website        String
  acceptsAlcohol Boolean @default(false)
  currency       String
  shipBase       Float
  shipPerBottle  Float
  daysMin        Int     @default(10)
  daysMax        Int     @default(20)
  active         Boolean @default(true)
}

model Offer {
  id          String    @id @default(cuid())
  wineId      String
  sellerId    String
  url         String
  price       Float // 병당 판매가 (판매처 통화)
  bottleMl    Int       @default(750)
  inStock     Boolean   @default(true)
  /// 장바구니 담기용 판매처 상품 식별자 (Shopify variant ID 등)
  checkoutRef String?
  checkedAt   DateTime  @default(now()) // 가격 확인 시각
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  wine   Wine       @relation(fields: [wineId], references: [id], onDelete: Cascade)
  seller Seller     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  clicks ClickLog[]

  @@unique([wineId, sellerId, bottleMl])
  @@index([sellerId])
}

model ExchangeRate {
  id       String   @id @default(cuid())
  currency String
  krw       Float // 1단위당 원화
  date      DateTime @db.Date // 기준일 (같은 날 여러 번 받으면 최신 값으로 덮어씀)
  source    String   @default("koreaexim") // investing | koreaexim | manual | seed
  fetchedAt DateTime @default(now()) // 실제로 받은 시각

  @@unique([currency, date])
}

/// 설정값 (세율, 할증률, FTA 국가 등). key별 JSON.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String? // 알림톡 수신 번호
  plan      Plan     @default(FREE)
  premiumUntil DateTime? // 포인트·보상으로 받은 프리미엄 기간

  // 커뮤니티
  nickname        String?   @unique
  adultVerifiedAt DateTime? // 휴대폰 본인인증 (만 19세 이상)
  birthDate       String? // YYYY-MM-DD
  ciHash          String?   @unique // 본인인증 연계정보 해시 (중복 가입 방지)
  founding        Boolean   @default(false) // 초기 초대 회원
  inviteCode      String?

  // 공유 카드 추천
  refCode         String?   @unique // 공유 카드 링크의 공유자 코드
  referredById    String? // 이 회원을 데려온 공유자
  hitWatchLimitAt DateTime? // 무료 찜 한도(3개)에 처음 닿은 때 (프리미엄 전환율 KPI)

  // 주문서 정보 (해외 판매처 결제 화면에 미리 채우거나 복사해서 붙여넣기)
  firstNameEn String?
  lastNameEn  String?
  address1En  String?
  address2En  String?
  cityEn      String?
  provinceEn  String?
  zip         String?
  pcccEnc     String? // 개인통관고유부호 (암호화 저장)
  pcccInNote  Boolean @default(true) // 결제 화면 주문 메모에 통관부호 넣기

  // 마케팅 수신 동의 (선택). null이면 미동의 또는 철회. 서비스 알림(가격 알림, 주문 상태)과 별개입니다.
  marketingConsentAt        DateTime?
  marketingConsentUpdatedAt DateTime? // 동의·철회를 바꾼 마지막 시각
  createdAt DateTime @default(now())

  sessions  Session[]
  orders    Order[]
  alerts    PriceAlert[]
  clicks    ClickLog[]
  purchases Purchase[]
  reviews   DirectReview[]
  helpfuls  Helpful[]
  reports   Report[]
  points    PointTx[]
  notifications Notification[]
  days      UserDay[]
  firstPurchaseGuide FirstPurchaseGuide?
  consultations Consultation[]
  consultationUsage ConsultationDailyUsage[]
  tasteProfile TasteProfile?
}

/// 상담은 민감 정보가 제거된 질문과 플랫폼 계산 근거만 보관합니다.
model Consultation {
  id         String @id @default(cuid())
  userId     String
  question   String
  answer     Json
  aiUsed     Boolean @default(false)
  model      String?
  inputTokens Int @default(0)
  outputTokens Int @default(0)
  helpful    Boolean?
  compareClickedAt DateTime?
  watchClickedAt DateTime?
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model ConsultationDailyUsage {
  userId String
  day    DateTime @db.Date
  count  Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, day])
}

/// 첫 직구 준비 체크와 시작·완료 시각. 통관부호는 여기 저장하지 않습니다.
model FirstPurchaseGuide {
  userId           String   @id
  pcccIssued       Boolean  @default(false)
  cardChecked      Boolean  @default(false)
  addressConfirmed Boolean  @default(false)
  preparedRoutes   String[] @default([])
  startedAt        DateTime @default(now())
  completedAt      DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

model Session {
  id        String   @id // 랜덤 토큰의 해시
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PriceAlert {
  id              String       @id @default(cuid())
  userId          String
  wineId          String
  qty             Int          @default(1)
  bottleMl        Int          @default(750)
  targetPerBottle Int // 목표 병당 도착가 (원)
  channel         AlertChannel @default(EMAIL)
  active          Boolean      @default(true)
  source          String? // detail | scan | share — 어디서 찜했는지
  lastPrice       Int? // 마지막으로 계산한 병당 도착가
  notifiedPrice   Int? // 마지막으로 알린 병당 도착가
  notifiedAt      DateTime?
  createdAt       DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  wine Wine @relation(fields: [wineId], references: [id], onDelete: Cascade)

  @@unique([userId, wineId, qty, bottleMl])
}

/// 판매처 이동(제휴 링크 클릭) 기록
model ClickLog {
  id          String   @id @default(cuid())
  offerId     String
  wineId      String
  userId      String?
  anonId      String?
  route       String
  qty         Int
  estPerBottle Int // 클릭 시점 예상 병당 도착가
  createdAt   DateTime @default(now())

  offer      Offer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  wine       Wine        @relation(fields: [wineId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversion Conversion?
  order      Order?

  @@index([createdAt])
}

/// 제휴사 포스트백으로 확인된 실제 주문 (북극성 지표: 월 구매 연결 건수)
model Conversion {
  id         String   @id @default(cuid())
  clickId    String   @unique
  orderRef   String?
  amount     Float?
  currency   String?
  commission Float?
  createdAt  DateTime @default(now())

  click ClickLog @relation(fields: [clickId], references: [id], onDelete: Cascade)
}

/// 사용자가 직접 입력한 구매 기록 (도착가 오차 검증용)
model Purchase {
  id           String   @id @default(cuid())
  userId       String
  wineId       String?
  sellerName   String
  route        String
  qty          Int
  goodsPaid    Float
  shipPaid     Float
  currency     String
  taxPaid      Int // 실제 납부 세금 (원)
  estTax       Int? // 같은 조건으로 계산한 예상 세금 (원)
  orderedAt    DateTime
  createdAt    DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wine  Wine?  @relation(fields: [wineId], references: [id], onDelete: SetNull)
  order Order?
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN // 신고 접수로 숨김 (운영자 확인 대기)
  DELETED
}

enum ProofStatus {
  NONE
  PENDING // 통관 내역 사진 제출, 운영자 확인 대기
  APPROVED // 인증 배지
  REJECTED
}

/// 직구 인증 후기 = 실제 경로 1건의 검증된 비용 기록
model DirectReview {
  id           String       @id @default(cuid())
  userId       String
  wineId       String
  sellerId     String?
  orderId      String?      @unique // 내 주문에서 쓴 후기
  route        String
  qty          Int
  bottleMl     Int          @default(750)
  taxPaid      Int // 실제 낸 세금 (원)
  estTax       Int? // 같은 조건 예상 세금 (원)
  cardPaidKrw  Int? // 판매처 결제 청구액 (원, 선택) — 실측 절약액 계산용
  shippingDays Int
  damaged      Boolean      @default(false)
  rating       Int // 1~5
  oneLiner     String
  sponsored    Boolean      @default(false) // 판매처로부터 대가를 받음 (표시 의무)
  status       ReviewStatus @default(PUBLISHED)
  proofStatus  ProofStatus  @default(NONE)
  proofNote    String?
  helpfulCount Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  wine     Wine       @relation(fields: [wineId], references: [id], onDelete: Cascade)
  seller   Seller?    @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  order    Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  proof    ProofFile?
  helpfuls Helpful[]
  reports  Report[]

  @@index([status, createdAt])
  @@index([wineId])
  @@index([sellerId])
}

/// 인증용 통관 내역·영수증 사진. 개인정보가 담겨 있어 운영자 확인이 끝나면 지웁니다.
model ProofFile {
  id        String   @id @default(cuid())
  reviewId  String   @unique
  mime      String
  data      Bytes
  createdAt DateTime @default(now())

  review DirectReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Helpful {
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  review DirectReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
}

model Report {
  id         String    @id @default(cuid())
  reviewId   String
  userId     String
  reason     String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolution String? // restored | deleted

  review DirectReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
}

/// 포인트 원장. 같은 사유·대상으로 두 번 지급되지 않습니다.
model PointTx {
  id        String   @id @default(cuid())
  userId    String
  amount    Int // 지급 +, 사용 -
  reason    String // review | proof | helpful10 | redeem_premium | admin | ...
  refId     String
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, refId])
  @@index([userId, createdAt])
}

model InviteCode {
  code          String   @id
  note          String?
  premiumMonths Int      @default(6)
  maxUses       Int      @default(1)
  uses          Int      @default(0)
  createdAt     DateTime @default(now())
}


model CrawlRun {
  id         String    @id @default(cuid())
  sellerId   String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("running") // running | ok | partial | failed
  updated    Int       @default(0)
  failed     Int       @default(0)
  message    String?

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, startedAt])
}

/// 출시 전 대기자
model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  wish      String?
  target    Int?
  purpose   String?
  createdAt DateTime @default(now())
}

model JobLog {
  id        String   @id @default(cuid())
  job       String
  ok        Boolean
  message   String
  createdAt DateTime @default(now())

  @@index([job, createdAt])
}

/// 와인 상세 조회 (경로 비교 → 판매처 이동률 계산용)
model WineView {
  id        String   @id @default(cuid())
  wineId    String
  anonId    String?
  createdAt DateTime @default(now())

  wine Wine @relation(fields: [wineId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

/// 손님의 주문 진행 상황. 판매처 결제 화면으로 넘어갈 때 만들고, 판매처 포스트백·손님·관리자가 상태를 바꿉니다.
model Order {
  id           String      @id @default(cuid())
  userId       String
  clickId      String      @unique
  wineId       String
  sellerId     String
  route        String
  qty          Int
  bottleMl     Int
  estTotal     Int // 이동 시점 예상 도착가 합계 (원)
  estTax       Int // 이동 시점 예상 세금 (원)
  status       OrderStatus @default(CLICKED)
  orderRef     String? // 판매처 주문번호
  carrier      String?
  trackingNo   String?
  trackingRegisteredAt DateTime?
  shipmentStage ShipmentStage?
  estimatedDeliveryAt DateTime?
  actualTax    Int? // 고지 또는 사용자가 확인한 실제 세금 (원)
  taxNoticeAt  DateTime?
  deliveredAt  DateTime?
  domesticCarrier String?
  domesticTrackingNo String?
  customsNo    String? // H B/L 번호 (운송장과 다른 경우)
  customsYear  Int?
  trackingSyncedAt DateTime?
  trackingUpdatedAt DateTime? // 공급자 데이터의 갱신 시각 (지연된 콜백 차단)
  trackingError String?
  purchaseId   String?     @unique // 도착 처리 때 남긴 구매 기록
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  click    ClickLog     @relation(fields: [clickId], references: [id], onDelete: Cascade)
  wine     Wine         @relation(fields: [wineId], references: [id], onDelete: Cascade)
  seller   Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  purchase Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  events   OrderEvent[]
  review   DirectReview?
  shipmentEvents ShipmentEvent[]

  @@index([userId, createdAt])
  @@index([status])
}

model ShipmentEvent {
  id         String @id @default(cuid())
  orderId    String
  stage      ShipmentStage
  source     String // customer | api | seller | admin
  occurredAt DateTime
  note       String?
  location   String?
  externalId String? // API 재전송 중복 방지
  createdAt  DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@unique([orderId, externalId])
  @@index([orderId, occurredAt])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  by        String // seller | customer | admin | system
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

/// 찜한 와인 조건별 하루 단위 도착가 기록 (30일 가격 선, 하락·재입고 감지)
model WatchPrice {
  id        String   @id @default(cuid())
  wineId    String
  qty       Int
  bottleMl  Int
  day       DateTime @db.Date
  perBottle Int? // null = 살 수 있는 경로 없음 (품절)
  route     String?
  updatedAt DateTime @updatedAt

  @@unique([wineId, qty, bottleMl, day])
}

enum NotificationType {
  TARGET // 목표가 도달
  DROP // 직전 대비 5% 이상 하락
  RESTOCK // 재입고
  VINTAGE // 신규 빈티지
  ALLOCATION // 와이너리 배정 오픈
  FX // 환율 30일 저점
  DIGEST // 무료 회원 주간 묶음
}

enum NotificationStatus {
  QUEUED // 무료 회원 주간 묶음 대기
  SENT
  FAILED
  SKIPPED // 묶음에 포함되어 개별 발송 안 함
}

/// 회원에게 보낸(또는 묶음 대기 중인) 알림. 링크는 /n/{id}를 거쳐 클릭률을 잽니다.
model Notification {
  id        String             @id @default(cuid())
  userId    String
  type      NotificationType
  wineId    String?
  title     String
  body      String
  link      String
  channel   String? // kakao | email
  status    NotificationStatus @default(SENT)
  dedupeKey String             @unique
  digestId  String? // 이 알림을 담아 보낸 주간 묶음
  sentAt    DateTime?
  clickedAt DateTime?
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, type])
}

/// 메일링 회원제 와이너리의 판매(배정) 시즌 시작
model AllocationOpen {
  id        String   @id @default(cuid())
  producer  String
  note      String
  url       String?
  createdAt DateTime @default(now())
}

/// 공유 카드 저장·공유 기록
model ShareEvent {
  id        String   @id @default(cuid())
  userId    String?
  anonId    String?
  kind      String // wine | review | month
  format    String // story | square
  action    String // save | share
  wineId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// 공유 카드 링크 방문
model RefVisit {
  id        String   @id @default(cuid())
  refCode   String
  anonId    String?
  path      String
  createdAt DateTime @default(now())

  @@index([refCode, createdAt])
}

/// 로그인 회원의 방문일 (재방문율 KPI)
model UserDay {
  userId String
  day    DateTime @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

/// 사진 검색 기록. 사진은 저장하지 않고 인식 결과만 남깁니다.
model ScanLog {
  id           String   @id @default(cuid())
  userId       String?
  provider     String
  extracted    Json // 인식한 와인 후보들 [{query, price, vintage}]
  topWineId    String?
  confidence   Float    @default(0)
  chosenWineId String? // 사용자가 고른 와인 (틀린 매칭 수정 데이터)
  correct      Boolean? // 첫 후보가 정답이었는지
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  @@index([createdAt])
}

/// 구해주세요: 국내에도 셀러도어 목록에도 없는 와인 요청 (미수입 와인 수요 리스트)
model WineRequest {
  id        String   @id @default(cuid())
  userId    String?
  text      String
  source    String // scan | manual
  scanId    String?
  status    String   @default("open") // open | added | closed
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/// 취향 설문 (선택). 소득·자산은 받지 않고 산지·종류·병당 예산 구간만 저장합니다.
model TasteProfile {
  userId    String   @id
  countries String[] @default([])
  types     String[] @default([])
  budget    String? // U50 | 50_100 | 100_200 | O200
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
