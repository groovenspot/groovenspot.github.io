# PostgreSQL
DATABASE_URL="postgresql://wine:wine@localhost:5432/wine?schema=public"

# 사이트 주소 (메일·알림톡 링크에 사용)
APP_URL="http://localhost:3000"

# 개인통관고유부호 암호화 키 (비우면 SESSION_SECRET 사용. 운영에서는 따로 두고 바꾸지 마세요)
ORDER_DATA_KEY=""

# 세션 쿠키 서명 키 (32자 이상 임의 문자열)
SESSION_SECRET="change-me-to-a-long-random-string-0123456789"

# 관리자 이메일 (쉼표로 구분)
ADMIN_EMAILS="admin@example.com"

# /api/cron/* 호출용 토큰 (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="change-me"

# 제휴사 전환 포스트백 검증 토큰 (/api/postback?secret=...)
POSTBACK_SECRET="change-me"

# 배송 추적 정규화 게이트웨이. 운송사·관세청·국내 배송 데이터를 공통 형식으로 제공하는 HTTPS URL입니다.
# 특정 운송사/관세청 API에 직접 연결하는 설정이 아닙니다. 비우면 자동 조회 없이 고객의 수동 등록·확인만 제공합니다.
TRACKING_API_URL=""
TRACKING_API_KEY=""
# 배송 상태 웹훅 인증키. 운영에서는 별도 임의 키를 설정하세요.
TRACKING_WEBHOOK_SECRET=""

# 도로명주소 영문 검색 API (https://business.juso.go.kr). 비우면 영문 주소를 직접 입력합니다.
JUSO_API_KEY=""

# 한국수출입은행 환율 API 인증키 (선택: ECB·ExchangeRate-API 다음 순서의 보충 출처, 또는 관리자 화면에서 주 출처로 선택) (https://www.koreaexim.go.kr/ir/HPHKIR020M01?apino=2)
KOREAEXIM_API_KEY=""

# 이메일 발송 (Resend). 비워 두면 서버 로그로 출력합니다.
RESEND_API_KEY=""
MAIL_FROM="셀러도어 <noreply@example.com>"

# 카카오 알림톡 (Solapi). 비워 두면 이메일로 대신 보냅니다.
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
SOLAPI_PFID=""
# 템플릿 변수: 가격·입고 알림 #{제목} #{내용} #{링크} / 주문 상태 #{와인} #{상태} #{판매처} #{링크}
SOLAPI_TEMPLATE_PRICE_ALERT=""
SOLAPI_TEMPLATE_PRICE_DROP=""
SOLAPI_TEMPLATE_RESTOCK=""
SOLAPI_TEMPLATE_VINTAGE=""
SOLAPI_TEMPLATE_ALLOCATION=""
SOLAPI_TEMPLATE_FX=""
SOLAPI_TEMPLATE_DIGEST=""
SOLAPI_TEMPLATE_ORDER_STATUS=""
SOLAPI_SENDER=""

# 휴대폰 본인인증 (PortOne V2, 커뮤니티 성인인증). 비우면 개발 환경에서만 생년월일 직접 입력으로 대신합니다.
NEXT_PUBLIC_PORTONE_STORE_ID=""
NEXT_PUBLIC_PORTONE_IDV_CHANNEL_KEY=""
PORTONE_API_SECRET=""
# 운영에서 개발용 인증을 강제로 켜는 스위치. 절대 운영에서 1로 두지 마세요.
ADULT_VERIFY_DEV=""

# 소셜 로그인. 키가 있는 곳만 로그인 화면에 버튼이 보입니다.
# 각 개발자 콘솔에 Redirect URI 로 {APP_URL}/login/oauth/kakao/callback, {APP_URL}/login/oauth/naver/callback 을 등록하세요.
# 카카오: 동의항목에서 '카카오계정(이메일)'을 필수로. 시크릿은 '클라이언트 시크릿'을 켠 경우에만.
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
# 네이버: 제공 정보에서 '이메일 주소'를 필수로.
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# 라벨 사진 검색. 기본은 Claude 이미지 인식(ANTHROPIC_API_KEY), 또는 Google Cloud Vision OCR.
# 둘 다 비우면 사진 인식 없이 라벨 글자 입력만 됩니다.
SCAN_PROVIDER="" # claude | google (비우면 키가 있는 쪽)
# 사진 인식 하루 한도 (유료 API 남용 방지). 비우면 기본값: 비회원 5, 회원 20, 1분 3, 전체 1000
SCAN_LIMIT_ANON=""
SCAN_LIMIT_MEMBER=""
SCAN_LIMIT_PER_MINUTE=""
SCAN_LIMIT_GLOBAL=""
# 라벨 인식과 직구 상담의 질문 분류에 함께 사용하는 Anthropic 키.
# 상담은 키가 없거나 호출에 실패해도 "AI 미사용"을 표시하고 플랫폼 계산·기본 절차 안내를 제공합니다.
ANTHROPIC_API_KEY=""
GOOGLE_VISION_API_KEY=""

# 직구 상담 1차: 질문 의도 분류만 모델을 사용하며 세금·금액은 플랫폼 계산기가 산출합니다.
CONSULTATION_MODEL="claude-haiku-4-5-20251001"
# 상담 기록 보관일. 기본 30일, 1~365일 범위로 제한합니다. 만료 기록은 consultation-cleanup 작업으로 삭제합니다.
CONSULTATION_RETENTION_DAYS="30"

# 공개 둘러보기 데모: 1 이면 화면 위에 예시 데이터 표시, 로그인·출시 알림 등록을 막습니다. 운영에서는 비워 두세요.
DEMO_MODE=""

# 브라우저 알림 (Web Push). `npx web-push generate-vapid-keys` 로 만든 두 키를 넣으세요. 비우면 메일·알림톡만 씁니다.
# 공개 키는 화면에 그대로 노출되는 값이고, 비공개 키는 서버에만 두세요. 한번 정하면 바꾸지 마세요(바꾸면 기존 구독이 모두 끊깁니다).
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
# 푸시 서비스에 알리는 연락처 (mailto: 또는 https:). 비우면 ADMIN_EMAILS 첫 주소.
WEB_PUSH_SUBJECT=""
