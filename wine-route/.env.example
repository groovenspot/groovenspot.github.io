# PostgreSQL
DATABASE_URL="postgresql://wine:wine@localhost:5432/wine?schema=public"

# 사이트 주소 (메일·알림톡 링크에 사용)
APP_URL="http://localhost:3000"

# 개인통관고유부호 암호화 키 (비우면 SESSION_SECRET 사용. 운영에서는 따로 두고 바꾸지 마세요)
ORDER_DATA_KEY=""

# 세션 쿠키 서명 키 (32자 이상 임의 문자열)
SESSION_SECRET="change-me-to-a-long-random-string-0123456789"

# 관리자 이메일 (쉼표로 구분)
ADMIN_EMAILS="admin@example.com"

# /api/cron/* 호출용 토큰 (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="change-me"

# 제휴사 전환 포스트백 검증 토큰 (/api/postback?secret=...)
POSTBACK_SECRET="change-me"

# 한국수출입은행 환율 API 인증키 (선택: investing.com 수신 실패 시 보충, 또는 관리자 화면에서 주 출처로 선택) (https://www.koreaexim.go.kr/ir/HPHKIR020M01?apino=2)
KOREAEXIM_API_KEY=""

# 이메일 발송 (Resend). 비워 두면 서버 로그로 출력합니다.
RESEND_API_KEY=""
MAIL_FROM="셀러도어 <noreply@example.com>"

# 카카오 알림톡 (Solapi). 비워 두면 이메일로 대신 보냅니다.
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
SOLAPI_PFID=""
# 템플릿 변수: 가격·입고 알림 #{제목} #{내용} #{링크} / 주문 상태 #{와인} #{상태} #{판매처} #{링크}
SOLAPI_TEMPLATE_PRICE_ALERT=""
SOLAPI_TEMPLATE_PRICE_DROP=""
SOLAPI_TEMPLATE_RESTOCK=""
SOLAPI_TEMPLATE_VINTAGE=""
SOLAPI_TEMPLATE_ALLOCATION=""
SOLAPI_TEMPLATE_FX=""
SOLAPI_TEMPLATE_DIGEST=""
SOLAPI_TEMPLATE_ORDER_STATUS=""
SOLAPI_SENDER=""

# 휴대폰 본인인증 (PortOne V2, 커뮤니티 성인인증). 비우면 개발 환경에서만 생년월일 직접 입력으로 대신합니다.
NEXT_PUBLIC_PORTONE_STORE_ID=""
NEXT_PUBLIC_PORTONE_IDV_CHANNEL_KEY=""
PORTONE_API_SECRET=""
# 운영에서 개발용 인증을 강제로 켜는 스위치. 절대 운영에서 1로 두지 마세요.
ADULT_VERIFY_DEV=""

# 라벨 사진 검색. 기본은 Claude 이미지 인식(ANTHROPIC_API_KEY), 또는 Google Cloud Vision OCR.
# 둘 다 비우면 사진 인식 없이 라벨 글자 입력만 됩니다.
SCAN_PROVIDER="" # claude | google (비우면 키가 있는 쪽)
ANTHROPIC_API_KEY=""
GOOGLE_VISION_API_KEY=""
